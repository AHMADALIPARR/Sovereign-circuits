module MalbolgeALU where

type Trit  = [2]
type Tryte = [10]Trit

tritAdd : Trit -> Trit -> Trit
tritAdd a b =
  if (a == 3) || (b == 3) then 0
  else
    let s = (0 # a) + (0 # b) : [3]
    in drop`{1} (if s >= 3 then s - 3 else s)

tritSub : Trit -> Trit -> Trit
tritSub a b =
  if (a == 3) || (b == 3) then 0
  else
    let d = ((0 # a) + 3 - (0 # b)) : [3]
    in drop`{1} (if d >= 3 then d - 3 else d)

crazyOp : Trit -> Trit -> Trit
crazyOp a b =
  if      a == 0 && b == 0 then 1
  else if a == 0 && b == 1 then 0
  else if a == 0 && b == 2 then 0
  else if a == 1 && b == 0 then 2
  else if a == 1 && b == 1 then 2
  else if a == 1 && b == 2 then 1
  else if a == 2 && b == 0 then 0
  else if a == 2 && b == 1 then 2
  else if a == 2 && b == 2 then 2
  else 0

permuteTryte : Tryte -> Tryte
permuteTryte t = [ crazyOp x x | x <- (t <<< 1) ]

// Lean axiom checks
property addSubInverse a b =
  ((a < 3) && (b < 3)) ==> (tritSub (tritAdd a b) b == a)

property crazySelfBound a =
  (a < 3) ==> ((crazyOp a a == 1) || (crazyOp a a == 2))
